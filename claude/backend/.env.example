# Database
DATABASE_URL=postgresql+asyncpg://ddms:password@localhost:5432/ddms

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=True
LOG_LEVEL=INFO

# Modbus
MODBUS_TIMEOUT=3
MODBUS_RETRY_ON_EMPTY=3
MODBUS_RETRY_ON_INVALID=3

# Scheduler
POLLING_INTERVAL=60
CLEANUP_INTERVAL=86400
DATA_RETENTION_DAYS=90
